{
  "name": "market-peek-likes",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ALLOWED_ORIGIN": "http://127.0.0.1:4212" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "market-peek-likes",
    "database_id": "local-only",
    "migrations_dir": "migrations"
  }]
}
